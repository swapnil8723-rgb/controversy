---
import Logo from './Logo.astro';
import { VERTICALS, VERTICAL, REGIONS, REGION } from '../lib/taxonomy';
const path = Astro.url.pathname;
const topicOn = VERTICALS.some((v) => path.startsWith(`/${v}/`));
---
<header class="sticky top-0 z-40 border-b border-line" style="background:color-mix(in oklab,var(--bg) 80%,transparent);backdrop-filter:saturate(1.4) blur(14px)">
  <div class="wrap flex h-14 items-center gap-2">
    <a href="/" class="no-underline" aria-label="Lorecheck home"><Logo /></a>
    <nav aria-label="Regions and topics" class="ml-5 hidden items-center gap-1 md:flex">
      {REGIONS.map((g) => {
        const on = path.startsWith(`/${g}/`);
        return (
          <a href={`/${g}/`} class:list={['rounded-full px-3.5 py-1.5 text-sm font-semibold no-underline transition-colors hover:bg-card-2', on && 'bg-card-2']} aria-current={on ? 'page' : undefined}>
            {REGION[g].flag} {REGION[g].label}
          </a>
        );
      })}
      <details class="topics relative">
        <summary class:list={['cursor-pointer list-none rounded-full px-3.5 py-1.5 text-sm font-semibold hover:bg-card-2', topicOn && 'bg-card-2']}>Topics ▾</summary>
        <div class="card absolute left-0 top-11 z-50 grid w-64 gap-0.5 p-2">
          {VERTICALS.map((v) => (
            <a href={`/${v}/`} class="flex items-center gap-2.5 rounded-xl px-3 py-2 text-sm font-semibold no-underline hover:bg-card-2" style={`color:var(--${v})`}>
              <span aria-hidden="true">{VERTICAL[v].emoji}</span>{VERTICAL[v].label}
            </a>
          ))}
        </div>
      </details>
      <a href="/latest/" class:list={['rounded-full px-3.5 py-1.5 text-sm font-semibold no-underline hover:bg-card-2', path.startsWith('/latest/') && 'bg-card-2']}>⚡ Latest</a>
    </nav>
    <div class="ml-auto flex items-center gap-1.5">
      <a href="/search/" class="flex h-10 items-center gap-2 rounded-full border border-line bg-card px-3 text-sm text-muted no-underline hover:text-text lg:w-56" aria-label="Search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="hidden lg:inline">Search the lore…</span>
      </a>
      <button type="button" id="theme-toggle" class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-card text-muted hover:text-text" aria-label="Switch light or dark theme">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      </button>
    </div>
  </div>
</header>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
  // Close the Topics menu when clicking elsewhere.
  document.addEventListener('click', (e) => {
    for (const d of document.querySelectorAll<HTMLDetailsElement>('details.topics[open]')) if (!d.contains(e.target as Node)) d.open = false;
  });
</script>
