---
import Logo from './Logo.astro';
import { VERTICALS, VERTICAL } from '../lib/taxonomy';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-line/70 backdrop-blur-md" style="background:color-mix(in oklab,var(--bg) 82%,transparent)">
  <div class="wrap flex h-14 items-center gap-3">
    <a href="/" class="no-underline" aria-label="Home"><Logo /></a>
    <nav aria-label="Sections" class="ml-4 hidden items-center gap-1 md:flex">
      {VERTICALS.map((v) => {
        const on = path.startsWith(`/${v}/`);
        return (
          <a href={`/${v}/`} class:list={['rounded-full px-3 py-1.5 text-sm font-semibold no-underline hover:bg-card-2', on && 'bg-card-2']} style={on ? `color:var(--${v})` : ''} aria-current={on ? 'page' : undefined}>
            {VERTICAL[v].label}
          </a>
        );
      })}
      <a href="/latest/" class:list={['rounded-full px-3 py-1.5 text-sm font-semibold no-underline hover:bg-card-2', path.startsWith('/latest/') && 'bg-card-2']}>Latest</a>
    </nav>
    <div class="ml-auto flex items-center gap-1.5">
      <a href="/search/" class="btn !min-h-10 !px-3 no-underline" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="hidden sm:inline">Search</span>
      </a>
      <button type="button" id="theme-toggle" class="btn !min-h-10 !px-3" aria-label="Switch light or dark theme">
        <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      </button>
    </div>
  </div>
</header>
<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
