---
import Logo from './Logo.astro';
import { BRAND } from '../site';
import { VERTICALS, VERTICAL, REGIONS, REGION } from '../lib/taxonomy';
---
<footer class="mt-16 border-t border-line pb-24 pt-10 md:pb-10">
  <div class="wrap grid grid-cols-2 gap-8 md:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
    <div class="col-span-2 md:col-span-1">
      <Logo />
      <p class="mt-3 max-w-sm text-sm text-muted">{BRAND.tagline} Every claim links to its source. Allegations are labelled. The other side is always included.</p>
    </div>
    <div>
      <p class="label">Topics</p>
      <ul class="mt-3 space-y-2 text-sm">
        {VERTICALS.map((v) => <li><a class="hover:underline" href={`/${v}/`}>{VERTICAL[v].label}</a></li>)}
        <li><a class="hover:underline" href="/latest/">Latest updates</a></li>
      </ul>
    </div>
    <div>
      <p class="label">Regions</p>
      <ul class="mt-3 space-y-2 text-sm">
        {REGIONS.map((g) => <li><a class="hover:underline" href={`/${g}/`}>{REGION[g].flag} {REGION[g].label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="label">Trust</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:underline" href="/editorial-policy/">Editorial policy</a></li>
        <li><a class="hover:underline" href="/corrections/">Corrections</a></li>
        <li><a class="hover:underline" href="/grievance/">Grievance officer</a></li>
        <li><a class="hover:underline" href="/about/">About</a></li>
      </ul>
    </div>
    <div>
      <p class="label">More</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:underline" href="/contact/">Contact</a></li>
        <li><a class="hover:underline" href="/privacy/">Privacy</a></li>
        <li><a class="hover:underline" href="/rss.xml">RSS feed</a></li>
      </ul>
    </div>
  </div>
  <p class="wrap mono mt-10 text-muted">© {new Date().getUTCFullYear()} {BRAND.name}. Facts link to their sources; we never publish a verdict a court or official body has not reached.</p>
</footer>
