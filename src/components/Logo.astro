---
// Wordmark: a torn-edge receipt with a tick, plus the brand name.
import { BRAND } from '../site';
interface Props { size?: number; withName?: boolean }
const { size = 28, withName = true } = Astro.props;
---
<span class="inline-flex items-center gap-2">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <path d="M7 3h18v24l-3-2-3 2-3-2-3 2-3-2-3 2z" fill="var(--accent)" />
    <path d="M11.5 15.5l3 3 6-6.5" fill="none" stroke="var(--accent-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  {withName && <span class="display text-[1.15rem] lowercase tracking-tight">{BRAND.name}</span>}
</span>
