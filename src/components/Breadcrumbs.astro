---
interface Props { items: { name: string; url: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="mono text-muted" data-pagefind-ignore>
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    {items.map((it, i) => (
      <li class="flex items-center gap-1.5">
        {i < items.length - 1 ? <a href={it.url} class="hover:text-text">{it.name}</a> : <span aria-current="page" class="text-text/80 line-clamp-1">{it.name}</span>}
        {i < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
