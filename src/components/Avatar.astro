---
// Initials avatar for a person, club or organisation. No photos: we only use images we
// own or license, so identity comes from a bold monogram in the category colour.
import { initials, type Ent } from '../lib/content';
interface Props { e: Ent; size?: number; ring?: boolean }
const { e, size = 44, ring = false } = Astro.props;
const label = initials(e);
const fs = size * (label.length >= 4 ? 0.26 : label.length === 3 ? 0.31 : 0.38);
---
<span
  class="avatar inline-flex shrink-0 items-center justify-center rounded-full font-black leading-none"
  style={`--v:var(--av-${e.data.vertical});width:${size}px;height:${size}px;font-size:${fs}px;background:linear-gradient(140deg,var(--v),color-mix(in oklab,var(--v) 78%,#000));color:#0b0b10;${ring ? 'box-shadow:0 0 0 3px var(--bg),0 0 0 5px var(--v)' : 'box-shadow:0 0 0 2px var(--bg)'}`}
  title={e.data.name}
  aria-hidden="true"
>{label}</span>
