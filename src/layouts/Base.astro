---
import '../styles/global.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import unboundedWoff2 from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import { BRAND, SITE_URL, abs } from '../site';
import { graph, organization, website } from '../lib/jsonld';

interface Props {
  title: string; // full <title>, brand appended unless it already contains it
  description: string;
  image?: string; // site-relative path to a 1200x630 image
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonld?: object[];
  published?: Date;
  modified?: Date;
  section?: string;
}
const { title, description, image = '/og-default.png', type = 'website', noindex = false, jsonld = [], published, modified, section } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL + '/').toString();
const fullTitle = title.includes(BRAND.name) ? title : `${title} | ${BRAND.name}`;
const ld = graph(organization(), website(), ...jsonld);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#0b0b10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${BRAND.name}: latest updates`} href="/rss.xml" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={unboundedWoff2} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={BRAND.handle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(image)} />

    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 btn btn-accent">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BottomNav />
  </body>
</html>
