---
import Base from '../layouts/Base.astro';
import RecordCard from '../components/RecordCard.astro';
import StoryRail from '../components/StoryRail.astro';
import NextUp from '../components/NextUp.astro';
import { loadAll, explainerUrl, ageDays, FRESH_DAYS } from '../lib/content';
import { VERTICALS, VERTICAL } from '../lib/taxonomy';
import { BRAND } from '../site';

const { records, explainers } = await loadAll();
const fresh = records.filter((r) => ageDays(r) <= FRESH_DAYS);
const [lead, ...rest] = fresh;
const counts = Object.fromEntries(VERTICALS.map((v) => [v, fresh.filter((r) => r.data.vertical === v).length]));
const sources = fresh.reduce((n, r) => n + r.data.sources.length, 0);
---
<Base title={`${BRAND.name}: this month's controversies, fact-checked`} description={BRAND.description}>
  <!-- Stories first: the freshest lore is one tap away, above the fold on phones -->
  <section class="wrap pt-4" aria-label="Latest stories">
    <StoryRail records={fresh.slice(0, 10)} />
  </section>

  <section class="wrap pt-6 sm:pt-10" aria-labelledby="hero">
    <p class="label" style="color:var(--link)">● Last 30 days · {fresh.length} stories · {sources} sources</p>
    <h1 id="hero" class="display mt-2 text-[2.6rem] sm:text-[4.2rem]">What's the lore?</h1>
    <p class="mt-2 max-w-xl text-[1.02rem] text-muted">This month's controversies, fact-checked. What happened, what's proven, what's only alleged, and where it stands now.</p>

    <!-- Topic filter: one feed, filtered in place (no separate thin URLs) -->
    <div class="no-bar -mx-1 mt-6 flex gap-2 overflow-x-auto px-1" role="group" aria-label="Filter by topic" data-filter>
      <button type="button" class="chip !min-h-10 !px-4 !text-[0.85rem] cursor-pointer" aria-pressed="true" data-v="all">All</button>
      {VERTICALS.map((v) => (
        <button type="button" class="chip !min-h-10 !px-4 !text-[0.85rem] cursor-pointer" aria-pressed="false" data-v={v}>{VERTICAL[v].emoji} {VERTICAL[v].label} <span class="text-muted">{counts[v]}</span></button>
      ))}
    </div>
  </section>

  <section class="wrap mt-5" aria-label="Fresh stories">
    {lead && <div data-card={lead.data.vertical}><RecordCard r={lead} variant="lead" /></div>}
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((r) => <div data-card={r.data.vertical}><RecordCard r={r} /></div>)}
    </div>
    <p class="mt-6 text-center text-sm text-muted">That's everything from the last {FRESH_DAYS} days.</p>
  </section>

  <section class="wrap mt-12" aria-labelledby="next">
    <div class="flex items-end justify-between gap-3">
      <h2 id="next" class="display text-[1.7rem]">⏭ What's next</h2>
      <a href="/latest/" class="text-sm font-semibold text-muted hover:text-text">All updates →</a>
    </div>
    <p class="mt-1 text-sm text-muted">Dates to watch in the stories we're tracking.</p>
    <div class="mt-4"><NextUp /></div>
  </section>

  {explainers.length > 0 && (
    <section class="wrap mt-12" aria-labelledby="explainers">
      <h2 id="explainers" class="display text-[1.7rem]">💡 Explained, simply</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {explainers.map((x) => (
          <a href={explainerUrl(x)} class="card lift flex items-start gap-3 p-4 no-underline" style={`--v:var(--${x.data.vertical})`}>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-lg" style="background:color-mix(in oklab,var(--v) 18%,transparent)" aria-hidden="true">{VERTICAL[x.data.vertical].emoji}</span>
            <span><span class="block font-bold leading-snug">{x.data.question}</span><span class="mt-1 block text-sm text-muted line-clamp-2">{x.data.summary}</span></span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="wrap mt-12" aria-labelledby="promise">
    <div class="card wash grid gap-6 p-6 sm:p-8 md:grid-cols-4" style="--v:var(--lime)">
      <h2 id="promise" class="display text-[1.7rem]">Lore, not rumours.</h2>
      <div><p class="font-bold">🧾 Receipts on every line</p><p class="mt-1 text-sm text-muted">Every sentence links to its source. No source, no publish.</p></div>
      <div><p class="font-bold">⚖️ Both sides, always</p><p class="mt-1 text-sm text-muted">Claims are labelled as claims, with the other side's response.</p></div>
      <div><p class="font-bold">🚫 No fake verdicts</p><p class="mt-1 text-sm text-muted">We only say "guilty" when a court or official body has. <a class="link" href="/editorial-policy/">Our rules</a></p></div>
    </div>
  </section>

  <script>
    const box = document.querySelector<HTMLElement>('[data-filter]');
    box?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-v]');
      if (!b) return;
      const want = b.dataset.v;
      box.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-card]').forEach((el) => (el.hidden = want !== 'all' && el.dataset.card !== want));
    });
  </script>
  <style>
    [data-filter] button[aria-pressed='true'] { background: var(--lime); color: var(--on-lime); border-color: transparent; }
    [data-filter] button[aria-pressed='true'] span { color: inherit; opacity: 0.7; }
  </style>
</Base>
