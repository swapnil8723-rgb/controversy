---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <div class="wrap max-w-2xl py-20 text-center">
    <p class="text-6xl" aria-hidden="true">🧾❓</p>
    <h1 class="display mt-6 text-[2rem]">No receipt for that one.</h1>
    <p class="mt-3 text-muted">The page you're after doesn't exist, or it moved.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-2">
      <a href="/" class="btn btn-accent">Home</a>
      <a href="/search/" class="btn">Search</a>
    </div>
  </div>
</Base>
