---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RecordCard from '../../components/RecordCard.astro';
import { loadAll, explainerUrl, entityUrl, recordsOfEntity } from '../../lib/content';
import { VERTICALS, VERTICAL, STATUS, STATUSES, KIND_SEGMENT, type Vertical } from '../../lib/taxonomy';
import { breadcrumbs } from '../../lib/jsonld';
import { abs } from '../../site';

export function getStaticPaths() {
  return VERTICALS.map((vertical) => ({ params: { vertical } }));
}
const vertical = Astro.params.vertical as Vertical;
const v = VERTICAL[vertical];
const { records, explainers, entities } = await loadAll();
const recs = records.filter((r) => r.data.vertical === vertical);
const exps = explainers.filter((x) => x.data.vertical === vertical);
const ents = (await Promise.all(entities.filter((e) => e.data.vertical === vertical).map(async (e) => ({ e, n: (await recordsOfEntity(e)).length }))))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n || a.e.data.name.localeCompare(b.e.data.name));
const present = STATUSES.filter((s) => recs.some((r) => r.data.status === s));
const crumbs = [{ name: 'Home', url: '/' }, { name: v.label, url: `/${vertical}/` }];
const ld = [
  breadcrumbs(crumbs),
  {
    '@type': 'CollectionPage',
    name: v.h1,
    description: v.seo,
    url: abs(`/${vertical}/`),
    hasPart: recs.map((r) => ({ '@type': 'NewsArticle', headline: r.data.title, url: abs(`/${vertical}/controversies/${r.id}/`) })),
  },
];
---
<Base title={`${v.h1}: timelines, rulings & latest status`} description={v.seo} jsonld={ld}>
  <section class="border-b border-line" style={`--v:var(--${vertical});background:radial-gradient(50rem 18rem at 100% 0%,color-mix(in oklab,var(--v) 16%,transparent),transparent 70%)`}>
    <div class="wrap py-8 sm:py-12">
      <Breadcrumbs items={crumbs} />
      <p class="mt-6 text-5xl" aria-hidden="true">{v.emoji}</p>
      <h1 class="display mt-3 text-[2.1rem] sm:text-[3.2rem]" style="color:var(--v)">{v.h1}</h1>
      <p class="mt-3 max-w-2xl text-[1.05rem] text-muted">{v.seo}</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <a href={`/${vertical}/latest/`} class="btn btn-accent">⚡ Latest updates</a>
        <a href={`/${vertical}/rss.xml`} class="btn">RSS</a>
      </div>
    </div>
  </section>

  <section class="wrap mt-8" aria-labelledby="all">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="all" class="display text-xl">All {v.label.toLowerCase()} stories <span class="text-muted">({recs.length})</span></h2>
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by status" data-filter>
        <button type="button" class="chip cursor-pointer" aria-pressed="true" data-status="all">All</button>
        {present.map((s) => <button type="button" class={`chip cursor-pointer ${STATUS[s].cls}`} aria-pressed="false" data-status={s}>{STATUS[s].label}</button>)}
      </div>
    </div>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {recs.map((r) => <li data-status={r.data.status}><RecordCard r={r} showVertical={false} /></li>)}
    </ul>
  </section>

  {exps.length > 0 && (
    <section class="wrap mt-12" aria-labelledby="exp">
      <h2 id="exp" class="display text-xl">Explained</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {exps.map((x) => (
          <a href={explainerUrl(x)} class="card card-link p-4 no-underline" style={`--v:var(--${vertical})`}>
            <p class="font-bold leading-snug">{x.data.title}</p>
            <p class="mt-1.5 text-sm text-muted">{x.data.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="wrap mt-12" aria-labelledby="who">
    <h2 id="who" class="display text-xl">People, clubs & organisations</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {ents.map(({ e, n }) => (
        <li><a href={entityUrl(e)} class="chip !min-h-10 !rounded-full !px-4 !text-[0.82rem] no-underline hover:border-muted">{e.data.name} <span class="text-muted">{n}</span></a></li>
      ))}
    </ul>
  </section>

  <script>
    const box = document.querySelector<HTMLElement>('[data-filter]');
    box?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-status]');
      if (!b) return;
      const want = b.dataset.status;
      box.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('li[data-status]').forEach((li) => (li.hidden = want !== 'all' && li.dataset.status !== want));
    });
  </script>
</Base>
