---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RecordCard from '../../components/RecordCard.astro';
import StoryRail from '../../components/StoryRail.astro';
import NextUp from '../../components/NextUp.astro';
import Avatar from '../../components/Avatar.astro';
import { loadAll, explainerUrl, entityUrl, recordsOfEntity, upcoming } from '../../lib/content';
import { VERTICALS, VERTICAL, type Vertical } from '../../lib/taxonomy';
import { breadcrumbs } from '../../lib/jsonld';
import { abs } from '../../site';

export function getStaticPaths() {
  return VERTICALS.map((vertical) => ({ params: { vertical } }));
}
const vertical = Astro.params.vertical as Vertical;
const v = VERTICAL[vertical];
const { records, explainers, entities } = await loadAll();
const recs = records.filter((r) => r.data.vertical === vertical);
const [lead, ...rest] = recs;
const exps = explainers.filter((x) => x.data.vertical === vertical);
const hasNext = (await upcoming()).some((x) => x.r.data.vertical === vertical);
const ents = (await Promise.all(entities.filter((e) => e.data.vertical === vertical).map(async (e) => ({ e, n: (await recordsOfEntity(e)).length }))))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n || a.e.data.name.localeCompare(b.e.data.name));
const crumbs = [{ name: 'Home', url: '/' }, { name: v.label, url: `/${vertical}/` }];
const ld = [
  breadcrumbs(crumbs),
  {
    '@type': 'CollectionPage',
    name: v.h1,
    description: v.seo,
    url: abs(`/${vertical}/`),
    hasPart: recs.map((r) => ({ '@type': 'NewsArticle', headline: r.data.title, url: abs(`/${vertical}/controversies/${r.id}/`) })),
  },
];
---
<Base title={`${v.h1}: latest, fact-checked`} description={v.seo} jsonld={ld}>
  <section class="border-b border-line" style={`--v:var(--${vertical});background:radial-gradient(60rem 22rem at 0% 0%,color-mix(in oklab,var(--v) 20%,transparent),transparent 65%)`}>
    <div class="wrap pb-8 pt-5">
      <Breadcrumbs items={crumbs} />
      <h1 class="display mt-6 text-[2.5rem] sm:text-[3.8rem]"><span aria-hidden="true">{v.emoji}</span> <span style="color:var(--v)">{v.label}</span> lore</h1>
      <p class="mt-2 max-w-2xl text-[1.02rem] text-muted">{v.seo}</p>
      {recs.length > 0 && <div class="mt-6"><StoryRail records={recs} /></div>}
    </div>
  </section>

  <section class="wrap mt-6" aria-label={`${v.label} stories`}>
    {recs.length === 0 && <p class="card p-6 text-muted">No fresh {v.label.toLowerCase()} stories right now. Check back soon.</p>}
    {lead && <RecordCard r={lead} variant="lead" showVertical={false} />}
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((r) => <RecordCard r={r} showVertical={false} />)}
    </div>
  </section>

  {hasNext && (
    <section class="wrap mt-12" aria-labelledby="next">
      <h2 id="next" class="display text-[1.6rem]">⏭ What's next</h2>
      <div class="mt-4"><NextUp vertical={vertical} /></div>
    </section>
  )}

  {exps.length > 0 && (
    <section class="wrap mt-12" aria-labelledby="exp">
      <h2 id="exp" class="display text-[1.6rem]">💡 Explained</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {exps.map((x) => (
          <a href={explainerUrl(x)} class="card lift p-4 no-underline" style={`--v:var(--${vertical})`}>
            <p class="font-bold leading-snug">{x.data.question}</p>
            <p class="mt-1.5 text-sm text-muted">{x.data.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {ents.length > 0 && (
    <section class="wrap mt-12" aria-labelledby="who">
      <h2 id="who" class="display text-[1.6rem]">Who's in the lore</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {ents.map(({ e, n }) => (
          <li>
            <a href={entityUrl(e)} class="card lift flex items-center gap-2.5 py-1.5 pl-1.5 pr-4 no-underline" style={`--v:var(--${vertical})`}>
              <Avatar e={e} size={32} />
              <span class="text-sm font-semibold">{e.data.name}</span>
              <span class="text-xs text-muted">{n}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="wrap mt-10 flex flex-wrap gap-2">
    <a href={`/${vertical}/latest/`} class="btn">⚡ Every {v.label.toLowerCase()} update</a>
    <a href={`/${vertical}/rss.xml`} class="btn">RSS</a>
  </div>
</Base>
