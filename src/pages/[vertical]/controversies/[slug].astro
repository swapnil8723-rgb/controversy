---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import StatusChip from '../../../components/StatusChip.astro';
import HeatBadge from '../../../components/HeatBadge.astro';
import VerticalTag from '../../../components/VerticalTag.astro';
import Claim from '../../../components/Claim.astro';
import SourceSheets from '../../../components/SourceSheets.astro';
import ShareBar from '../../../components/ShareBar.astro';
import StoryMode from '../../../components/StoryMode.astro';
import RecordCard from '../../../components/RecordCard.astro';
import { loadAll, entitiesOf, entityUrl, explainerUrl, recordUrl, heatOf, type Rec } from '../../../lib/content';
import { VERTICAL, STATUS } from '../../../lib/taxonomy';
import { day, month, iso, anchor } from '../../../lib/format';
import { article, breadcrumbs } from '../../../lib/jsonld';
import { BRAND } from '../../../site';

export async function getStaticPaths() {
  const { records } = await loadAll();
  return records.map((r) => ({ params: { vertical: r.data.vertical, slug: r.id }, props: { r } }));
}

const { r } = Astro.props as { r: Rec };
const d = r.data;
const { Content } = await render(r);
const hasBody = !!r.body?.trim();
const { records, explainers } = await loadAll();
const ents = await entitiesOf(r);
const related = d.related.map((ref) => records.find((x) => x.id === ref.id)).filter((x): x is Rec => !!x);
const moreSame = records.filter((x) => x.data.vertical === d.vertical && x.id !== r.id && !related.includes(x)).slice(0, 3 - Math.min(3, related.length));
const explained = explainers.filter((x) => x.data.records.some((ref) => ref.id === r.id));
const v = VERTICAL[d.vertical];
const url = recordUrl(r);
const crumbs = [
  { name: 'Home', url: '/' },
  { name: v.label, url: `/${d.vertical}/` },
  { name: d.title, url },
];
const dateText = (t: Rec['data']['timeline'][number]) => t.dateLabel ?? day(t.date);
const storyEvents = d.timeline.map((t) => ({ date: dateText(t), headline: t.headline, text: t.claims[0].text }));
const sourceCount = d.sources.length;
const primaryCount = d.sources.filter((s) => s.tier !== 'major-outlet').length;
const words = [d.tldr.join(' '), ...d.timeline.flatMap((t) => t.claims.map((c) => c.text)), r.body ?? ''].join(' ').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 230));
const ld = [
  article({
    url,
    headline: d.seoTitle ?? d.title,
    description: d.summary,
    image: `/og/${r.id}.png`,
    published: d.published,
    modified: d.updated,
    section: v.label,
    keywords: d.keywords,
    about: ents.map((e) => ({ name: e.data.name, sameAs: e.data.sameAs, type: e.data.kind === 'person' ? 'Person' : e.data.kind === 'club' || e.data.kind === 'team' ? 'SportsTeam' : 'Organization' })),
    citations: d.sources.map((s) => s.url),
  }),
  breadcrumbs(crumbs),
];
---
<Base title={d.seoTitle ?? d.title} description={d.summary} image={`/og/${r.id}.png`} type="article" jsonld={ld} published={d.published} modified={d.updated} section={v.label}>
  <article class="wrap pt-5" style={`--v:var(--${d.vertical})`} data-pagefind-body data-pagefind-meta={`vertical:${v.label}`}>
    <Breadcrumbs items={crumbs} />

    <header class="mt-5 max-w-3xl">
      <div class="flex flex-wrap items-center gap-1.5" data-pagefind-ignore>
        <VerticalTag vertical={d.vertical} />
        <StatusChip status={d.status} size="md" />
        <HeatBadge heat={heatOf(r)} />
      </div>
      <h1 class="display mt-4 text-[1.9rem] sm:text-[2.6rem]">{d.title}</h1>
      <p class="mono mt-4 text-muted" data-pagefind-ignore>
        Last verified <time datetime={iso(d.lastVerified)}>{day(d.lastVerified)}</time> · {sourceCount} sources ({primaryCount} primary) · {minutes} min read
      </p>
    </header>

    <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0">
        <!-- The 30-second version -->
        <section aria-labelledby="tldr" class="card relative overflow-hidden p-5 sm:p-6" style="border-color:color-mix(in oklab,var(--v) 40%,var(--line))">
          <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full opacity-20 blur-3xl" style="background:var(--v)"></div>
          <h2 id="tldr" class="kicker" style="color:var(--v)">TL;DR · the 30-second version</h2>
          <ol class="mt-3 space-y-3">
            {d.tldr.map((t, i) => (
              <li class="flex gap-3">
                <span class="display mt-0.5 text-sm" style="color:var(--v)" data-pagefind-ignore>{i + 1}</span>
                <span class="text-[1.03rem] leading-relaxed">{t}</span>
              </li>
            ))}
          </ol>
          <div class="mt-5 flex flex-wrap gap-2" data-pagefind-ignore>
            <StoryMode vertical={d.vertical} status={d.status} title={d.title} tldr={d.tldr} events={storyEvents} standing={d.statusNote} brand={BRAND.name} />
            <a class="btn" href="#timeline">Full timeline ↓</a>
          </div>
        </section>

        <!-- Where it stands -->
        <section aria-labelledby="stands" class={`mt-4 rounded-2xl border p-4 ${STATUS[d.status].cls}`} style="background:color-mix(in oklab,currentColor 7%,transparent)">
          <h2 id="stands" class="kicker" style="color:inherit">Where it stands · {STATUS[d.status].label}</h2>
          <p class="mt-1.5 font-semibold text-text">{d.statusNote}</p>
          <p class="mt-1 text-sm text-muted">{STATUS[d.status].long}</p>
        </section>

        {d.keyFacts.length > 0 && (
          <section aria-labelledby="facts" class="mt-8">
            <h2 id="facts" class="display text-xl">Key facts</h2>
            <dl class="mt-3 grid grid-cols-2 gap-2">
              {d.keyFacts.map((f) => (
                <div class="card p-3.5">
                  <dt class="kicker">{f.label}</dt>
                  <dd class="mt-1 text-[0.92rem] font-semibold leading-snug sm:text-base">{f.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <!-- Timeline: dated headings so readers and Google can jump to each event -->
        <section aria-labelledby="timeline" class="mt-10">
          <h2 id="timeline" class="display text-xl">Timeline</h2>
          <p class="mt-1 text-sm text-muted">Tap a 🧾 chip to see the source. <span style="color:var(--accent)">Highlighted</span> chips are primary sources: official bodies, courts or the people involved.</p>
          <ol class="relative mt-6 border-l-2 pl-6" style="border-color:color-mix(in oklab,var(--v) 35%,var(--line))">
            {d.timeline.map((t, i) => (
              <li class="relative pb-8 last:pb-0" id={anchor(t.date, i)}>
                <span class="absolute -left-[33px] top-1 h-4 w-4 rounded-full border-4" style="background:var(--v);border-color:var(--bg)" aria-hidden="true"></span>
                <h3>
                  <time class="mono block font-medium" style="color:var(--v)" datetime={iso(t.date)}>{dateText(t)}</time>
                  <span class="mt-1 block text-[1.12rem] font-bold leading-snug">{t.headline}</span>
                </h3>
                <div class="mt-3 space-y-4">
                  {t.claims.map((c) => <Claim text={c.text} kind={c.kind} by={c.by} cite={c.cite} sources={d.sources} />)}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- The other side: mandatory when an allegation appears -->
        {(d.responses.length > 0 || d.noResponseFound) && (
          <section aria-labelledby="responses" class="mt-10">
            <h2 id="responses" class="display text-xl">The other side</h2>
            <div class="card mt-4 space-y-5 p-5">
              {d.responses.map((c) => <Claim text={c.text} kind={c.kind} by={c.by} cite={c.cite} sources={d.sources} />)}
              {d.noResponseFound && (
                <p class="text-muted">We looked for a response on {day(d.noResponseFound.checkedOn)}. {d.noResponseFound.note}</p>
              )}
            </div>
          </section>
        )}

        {hasBody && (
          <section class="prose-r mt-6 max-w-none">
            <Content />
          </section>
        )}

        {explained.length > 0 && (
          <section aria-labelledby="explained" class="mt-10" data-pagefind-ignore>
            <h2 id="explained" class="display text-xl">Explained</h2>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              {explained.map((x) => (
                <a href={explainerUrl(x)} class="card card-link p-4 no-underline">
                  <p class="kicker">Explainer</p>
                  <p class="mt-1.5 font-bold leading-snug">{x.data.title}</p>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Receipts -->
        <section aria-labelledby="sources" class="mt-10">
          <h2 id="sources" class="display text-xl">Sources</h2>
          <ol class="mt-4 space-y-3">
            {d.sources.map((s, i) => (
              <li class="card flex gap-3 p-4">
                <span class="display text-sm" style="color:var(--v)">{i + 1}</span>
                <div class="min-w-0">
                  <p class="font-semibold">{s.name} <span class="chip ml-1" style={s.tier !== 'major-outlet' ? 'color:var(--accent)' : 'color:var(--muted)'}>{s.tier === 'major-outlet' ? 'Reported' : s.tier === 'on-record' ? 'On record' : s.tier === 'court' ? 'Court' : 'Official'}</span></p>
                  <p class="mt-0.5 text-sm text-muted">{s.title}</p>
                  <p class="mono mt-1.5 text-muted">
                    {s.published && <>{day(s.published)} · </>}
                    <a class="link" href={s.url} target="_blank" rel="noopener nofollow">Original</a>
                    {s.archiveUrl && <> · <a class="link" href={s.archiveUrl} target="_blank" rel="noopener nofollow">Archived</a></>}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- Corrections and editorial note -->
        <section aria-labelledby="corrections" class="mt-10" data-pagefind-ignore>
          <h2 id="corrections" class="display text-xl">Corrections</h2>
          {d.corrections.length === 0 ? (
            <p class="mt-2 text-muted">No corrections so far.</p>
          ) : (
            <ul class="mt-3 space-y-2">{d.corrections.map((c) => <li class="card p-3"><span class="mono text-muted">{day(c.date)}</span> · {c.note}</li>)}</ul>
          )}
          <p class="mt-3 text-sm text-muted">
            Spotted something wrong or one-sided? <a class="link" href={`/contact/?about=${encodeURIComponent(url)}`}>Tell us</a>. We acknowledge reports within 24 hours and log every fix on the <a class="link" href="/corrections/">corrections page</a>.
          </p>
          <p class="mono mt-3 text-muted">
            Published {day(d.published)} · Updated {day(d.updated)} · Reviewed by {d.reviewedBy}
          </p>
        </section>
      </div>

      <!-- Side rail: who's involved + share (sticky on desktop) -->
      <aside class="lg:sticky lg:top-20 lg:self-start" data-pagefind-ignore>
        <div class="card p-4">
          <p class="kicker">Share the receipts</p>
          <div class="mt-3"><ShareBar url={url} title={d.title} storyCard={`/og/${r.id}-story.png`} /></div>
        </div>
        <div class="card mt-4 p-4">
          <p class="kicker">Who's involved</p>
          <ul class="mt-3 space-y-2">
            {ents.map((e) => (
              <li>
                <a href={entityUrl(e)} class="flex items-center justify-between gap-2 rounded-xl px-2 py-2 no-underline hover:bg-card-2">
                  <span><span class="block font-semibold leading-tight">{e.data.name}</span><span class="text-xs text-muted">{e.data.role}</span></span>
                  <span aria-hidden="true" class="text-muted">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <nav aria-label="On this page" class="card mt-4 hidden p-4 lg:block">
          <p class="kicker">Jump to</p>
          <ol class="mt-2 space-y-1.5 text-sm">
            {d.timeline.map((t, i) => (
              <li><a class="flex gap-2 no-underline hover:underline" href={`#${anchor(t.date, i)}`}><span class="mono shrink-0 text-muted">{t.dateLabel ?? month(t.date)}</span><span class="line-clamp-1">{t.headline}</span></a></li>
            ))}
          </ol>
        </nav>
      </aside>
    </div>

    {(related.length + moreSame.length) > 0 && (
      <section aria-labelledby="more" class="mt-14" data-pagefind-ignore>
        <h2 id="more" class="display text-xl">Keep reading</h2>
        <div class="rail mt-4">
          {[...related, ...moreSame].slice(0, 3).map((x) => <RecordCard r={x} />)}
        </div>
      </section>
    )}
  </article>
  <SourceSheets sources={d.sources} />
</Base>
