---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RecordCard from '../../../components/RecordCard.astro';
import VerticalTag from '../../../components/VerticalTag.astro';
import ShareBar from '../../../components/ShareBar.astro';
import { loadAll, explainerUrl, type Exp, type Rec } from '../../../lib/content';
import { VERTICAL, TIER } from '../../../lib/taxonomy';
import { day } from '../../../lib/format';
import { article, breadcrumbs } from '../../../lib/jsonld';

export async function getStaticPaths() {
  const { explainers } = await loadAll();
  return explainers.map((x) => ({ params: { vertical: x.data.vertical, slug: x.id }, props: { x } }));
}
const { x } = Astro.props as { x: Exp };
const d = x.data;
const { Content } = await render(x);
const { records } = await loadAll();
const recs = d.records.map((ref) => records.find((r) => r.id === ref.id)).filter((r): r is Rec => !!r);
const v = VERTICAL[d.vertical];
const url = explainerUrl(x);
const crumbs = [{ name: 'Home', url: '/' }, { name: v.label, url: `/${d.vertical}/` }, { name: d.title, url }];
const ld = [
  article({ url, headline: d.seoTitle ?? d.title, description: d.summary, image: `/og/${x.id}.png`, published: d.published, modified: d.updated, section: v.label, citations: d.sources.map((s) => s.url) }),
  breadcrumbs(crumbs),
];
---
<Base title={d.seoTitle ?? d.title} description={d.summary} image={`/og/${x.id}.png`} type="article" jsonld={ld} published={d.published} modified={d.updated} section={v.label}>
  <article class="wrap pt-6" style={`--v:var(--${d.vertical})`} data-pagefind-body>
    <Breadcrumbs items={crumbs} />
    <div class="mx-auto max-w-3xl">
      <div class="mt-6 flex flex-wrap gap-1.5" data-pagefind-ignore><VerticalTag vertical={d.vertical} /><span class="chip">Explainer</span></div>
      <h1 class="display mt-4 text-[1.9rem] sm:text-[2.6rem]">{d.title}</h1>

      <section class="card mt-6 p-5 sm:p-6" style="border-color:color-mix(in oklab,var(--v) 45%,var(--line))" aria-labelledby="answer">
        <h2 id="answer" class="label" style="color:var(--v)">Short answer</h2>
        <p class="mt-1.5 font-semibold text-muted">{d.question}</p>
        <p class="mt-3 text-[1.08rem] leading-relaxed">{d.shortAnswer}</p>
      </section>

      <div class="prose-r mt-6"><Content /></div>

      {recs.length > 0 && (
        <section class="mt-10" aria-labelledby="recs" data-pagefind-ignore>
          <h2 id="recs" class="display text-[1.6rem]">The full timelines</h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">{recs.map((r) => <RecordCard r={r} showVertical={false} />)}</div>
        </section>
      )}

      <section class="mt-10" aria-labelledby="src">
        <h2 id="src" class="display text-[1.6rem]">Sources</h2>
        <ol class="mt-3 space-y-2 text-sm">
          {d.sources.map((s, i) => (
            <li class="card p-3.5">
              <span class="display mr-2 text-xs" style="color:var(--v)">{i + 1}</span>
              <span class="font-semibold">{s.name}</span> <span class="text-muted">({TIER[s.tier].label})</span>: {s.title}.{' '}
              <a class="link" href={s.url} target="_blank" rel="noopener nofollow">Original</a>
              {s.archiveUrl && <> · <a class="link" href={s.archiveUrl} target="_blank" rel="noopener nofollow">Archived</a></>}
            </li>
          ))}
        </ol>
        <p class="mono mt-4 text-muted" data-pagefind-ignore>Published {day(d.published)} · Updated {day(d.updated)} · Reviewed by {d.reviewedBy}</p>
      </section>

      <div class="card mt-8 p-4" data-pagefind-ignore>
        <p class="label">Share this explainer</p>
        <div class="mt-3"><ShareBar url={url} title={d.title} ogCard={`/og/${x.id}.png`} /></div>
      </div>
    </div>
  </article>
</Base>
