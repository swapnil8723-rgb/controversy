---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LatestFeed from '../components/LatestFeed.astro';
import { loadAll } from '../lib/content';
import { VERTICALS, VERTICAL } from '../lib/taxonomy';
import { breadcrumbs } from '../lib/jsonld';

const { records } = await loadAll();
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Latest', url: '/latest/' }];
---
<Base title="Latest controversy updates: football, cricket, entertainment" description="Every new official development across the controversies we track, newest first: rulings, appeals, statements and decisions, each with its source." jsonld={[breadcrumbs(crumbs)]}>
  <div class="wrap pt-6">
    <Breadcrumbs items={crumbs} />
    <h1 class="display mt-5 text-[2rem] sm:text-[2.8rem]">⚡ Latest updates</h1>
    <p class="mt-3 max-w-2xl text-muted">Every dated development we've verified, newest first. Tap one to jump to it in its full timeline.</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {VERTICALS.map((v) => <a href={`/${v}/latest/`} class="chip !min-h-10 !rounded-full !px-4 no-underline" style={`color:var(--${v})`}>{VERTICAL[v].emoji} {VERTICAL[v].label}</a>)}
    </div>
    <LatestFeed records={records} />
  </div>
</Base>
